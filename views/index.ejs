<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Clientes</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 30px;
            text-align: center;
            position: relative;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .header .subtitle {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .btn-novo {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.1em;
            margin: 30px 0;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-novo:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
        }

        .content {
            padding: 30px;
        }

        .btn-container {
            text-align: center;
            margin-bottom: 30px;
        }

        .clientes-grid {
            display: grid;
            gap: 20px;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        }

        .cliente-card {
            background: #f8f9ff;
            border: 2px solid #e3e8ff;
            border-radius: 12px;
            padding: 25px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .cliente-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border-color: #4facfe;
        }

        .cliente-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .cliente-nome {
            font-size: 1.3em;
            font-weight: bold;
            color: #333;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

        .cliente-nome::before {
            content: '👤';
            margin-right: 10px;
            font-size: 1.2em;
        }

        .cliente-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-action {
            flex: 1;
            min-width: 80px;
            padding: 8px 16px;
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.9em;
            font-weight: bold;
            text-align: center;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .btn-detalhes {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }

        .btn-detalhes:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
        }

        .btn-editar {
            background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
            color: #333;
        }

        .btn-editar:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(253, 203, 110, 0.4);
        }

        .btn-excluir {
            background: linear-gradient(135deg, #fd79a8 0%, #e84393 100%);
            color: white;
        }

        .btn-excluir:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(232, 67, 147, 0.4);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #666;
        }

        .empty-state .emoji {
            font-size: 4em;
            margin-bottom: 20px;
        }

        .empty-state h3 {
            font-size: 1.5em;
            margin-bottom: 10px;
            color: #333;
        }

        .empty-state p {
            font-size: 1.1em;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .clientes-grid {
                grid-template-columns: 1fr;
            }
            
            .cliente-actions {
                flex-direction: column;
            }
            
            .btn-action {
                flex: none;
            }
            
            .header h1 {
                font-size: 2em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Sistema de Clientes</h1>
            <p class="subtitle">Gerencie seus clientes de forma simples e eficiente</p>
        </div>
        
        <div class="content">
            <div class="btn-container">
                <a href="/novo" class="btn-novo">+ Novo Cliente</a>
            </div>

            <% if (clientes && clientes.length > 0) { %>
                <div class="clientes-grid">
                    <% clientes.forEach(cliente => { %>
                        <div class="cliente-card">
                            <div class="cliente-name"><%= cliente.name %></div>
                            <div class="cliente-actions">
                                <a href="/detalhes/<%= cliente.idCliente %>" class="btn-action btn-detalhes">Detalhes</a>
                                <a href="/editar/<%= cliente.idCliente %>" class="btn-action btn-editar">Editar</a>
                                <a href="/excluir/<%= cliente.idCliente %>" class="btn-action btn-excluir" 
                                   onclick="return confirm('Tem certeza que deseja excluir este cliente?')">Excluir</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="emoji">📋</div>
                    <h3>Nenhum cliente cadastrado</h3>
                    <p>Comece adicionando seu primeiro cliente clicando no botão "Novo Cliente" acima.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
