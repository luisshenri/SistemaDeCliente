<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes do Cliente - Sistema de Clientes</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 30px;
            text-align: center;
            position: relative;
        }

        .header h1 {
            font-size: 2.2em;
            margin-bottom: 10px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .header .subtitle {
            font-size: 1em;
            opacity: 0.9;
        }

        .header .icon {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .content {
            padding: 40px;
        }

        .profile-card {
            background: #f8f9ff;
            border-radius: 12px;
            padding: 30px;
            border: 2px solid #e3e8ff;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
        }

        .profile-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .profile-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e3e8ff;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 2.5em;
            color: white;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .profile-name {
            font-size: 1.8em;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .profile-id {
            color: #666;
            font-size: 1em;
            opacity: 0.7;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-item {
            background: white;
            padding: 20px;
            border-radius: 10px;
            border: 2px solid #e3e8ff;
            transition: all 0.3s ease;
            position: relative;
        }

        .detail-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            border-color: #4facfe;
        }

        .detail-label {
            display: flex;
            align-items: center;
            font-weight: bold;
            color: #333;
            margin-bottom: 8px;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-label .icon {
            margin-right: 8px;
            font-size: 1.2em;
        }

        .detail-value {
            font-size: 1.1em;
            color: #555;
            word-break: break-word;
            line-height: 1.4;
        }

        .detail-value.empty {
            color: #999;
            font-style: italic;
        }

        .actions-container {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            transition: all 0.3s ease;
            min-width: 120px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
            color: #333;
            box-shadow: 0 5px 15px rgba(253, 203, 110, 0.4);
        }

        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(253, 203, 110, 0.6);
        }

        .btn-danger {
            background: linear-gradient(135deg, #fd79a8 0%, #e84393 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(232, 67, 147, 0.4);
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(232, 67, 147, 0.6);
        }

        .btn-outline {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
        }

        .btn-outline:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }

        .status-badge {
            display: inline-block;
            padding: 5px 15px;
            background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
            color: white;
            border-radius: 20px;
            font-size: 0.8em;
            font-weight: bold;
            margin-top: 10px;
        }

        @media (max-width: 768px) {
            .container {
                margin: 10px;
                border-radius: 10px;
            }
            
            .content {
                padding: 20px;
            }
            
            .profile-card {
                padding: 20px;
            }
            
            .details-grid {
                grid-template-columns: 1fr;
            }
            
            .actions-container {
                flex-direction: column;
            }
            
            .btn {
                width: 100%;
            }
            
            .header h1 {
                font-size: 1.8em;
            }
        }

        .breadcrumb {
            margin-bottom: 20px;
            font-size: 0.9em;
            color: #666;
        }

        .breadcrumb a {
            color: #4facfe;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="icon">📋</div>
            <h1>Detalhes do Cliente</h1>
            <p class="subtitle">Informações completas do cadastro</p>
        </div>
        
        <div class="content">
            <div class="breadcrumb">
                <a href="/">🏠 Início</a> > Detalhes do Cliente
            </div>
            
            <div class="profile-card">
                <div class="profile-header">
                    <div class="profile-avatar">👤</div>
                    <div class="profile-name"><%= cliente.name || 'Nome não informado' %></div>
                    <div class="profile-id">ID: #<%= cliente.idCliente || 'N/A' %></div>
                    <div class="status-badge">✅ Ativo</div>
                </div>

                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">
                            <span class="icon">🆔</span>
                            CPF
                        </div>
                        <div class="detail-value <%= !cliente.cpf ? 'empty' : '' %>">
                            <%= cliente.cpf || 'Não informado' %>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">
                            <span class="icon">📧</span>
                            E-mail
                        </div>
                        <div class="detail-value <%= !cliente.email ? 'empty' : '' %>">
                            <%= cliente.email || 'Não informado' %>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">
                            <span class="icon">📅</span>
                            Data de Nascimento
                        </div>
                        <div class="detail-value <%= !cliente.dataNascimento ? 'empty' : '' %>">
                            <% if (cliente.dataNascimento) { %>
                                <%= new Date(cliente.dataNascimento).toLocaleDateString('pt-BR') %>
                            <% } else { %>
                                Não informado
                            <% } %>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">
                            <span class="icon">📱</span>
                            Telefone
                        </div>
                        <div class="detail-value <%= !cliente.telefone ? 'empty' : '' %>">
                            <%= cliente.telefone || 'Não informado' %>
                        </div>
                    </div>

                    <div class="detail-item" style="grid-column: 1 / -1;">
                        <div class="detail-label">
                            <span class="icon">🏠</span>
                            Endereço
                        </div>
                        <div class="detail-value <%= !cliente.endereco ? 'empty' : '' %>">
                            <%= cliente.endereco || 'Não informado' %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="actions-container">
                <a href="/editar/<%= cliente.idCliente %>" class="btn btn-secondary">
                    ✏️ Editar
                </a>
                <a href="/excluir/<%= cliente.idCliente %>" class="btn btn-danger" 
                   onclick="return confirm('Tem certeza que deseja excluir este cliente?')">
                    🗑️ Excluir
                </a>
                <a href="/" class="btn btn-outline">
                    ← Voltar
                </a>
            </div>
        </div>
    </div>

    <script>
        
        window.addEventListener('load', function() {
            const detailItems = document.querySelectorAll('.detail-item');
            detailItems.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                
                setTimeout(() => {
                    item.style.transition = 'all 0.5s ease';
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
</html>
